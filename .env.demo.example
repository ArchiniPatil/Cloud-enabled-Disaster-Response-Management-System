# Explicit test fixtures only. Use npm run setup:demo and npm run dev:demo.
NODE_ENV=development
AUTH_MODE=demo
DATABASE_URL=postgresql://response:local-development-only@127.0.0.1:5432/response
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:4000
AWS_REGION=ap-south-1
PORT=4000
SMS_ENABLED=false
NOTIFICATION_TRANSPORT=simulator
LOCATION_RETENTION_HOURS=24
# Production uses AUTH_MODE=cognito, HTTPS, a secure random SESSION_KEY,
# COGNITO_POOL_ID, COGNITO_CLIENT_ID, COGNITO_DOMAIN, DATABASE_SECRET_ARN,
# EVIDENCE_BUCKET, EVENT_TOPIC_ARN, LOCATION_MAP_NAME, LOCATION_ROUTE_CALCULATOR.
# NODE_EXTRA_CA_CERTS must point to the verified RDS CA bundle.
# EMERGENCY_PHONE is optional; configure only a verified local number.
