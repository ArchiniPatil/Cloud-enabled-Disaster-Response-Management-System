{
  "name": "disaster-response",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web,worker \"npm run dev -w apps/api\" \"npm run dev -w apps/web\" \"npm run worker\"",
    "build": "npm run typecheck && npm run build -w apps/web && tsup apps/api/src/server.ts apps/api/src/worker.ts apps/api/src/lambda.ts --format esm --platform node --out-dir dist/api --external pg-native && tsup scripts/migrate.ts scripts/bootstrap-admin.ts --format esm --platform node --out-dir dist/scripts --external pg-native",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "worker": "tsx apps/api/src/worker.ts",
    "infra:synth": "cdk synth --app \"npx tsx infra/app.ts\"",
    "infra:diff": "cdk diff --app \"npx tsx infra/app.ts\"",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "dev:local": "node scripts/dev-local.mjs",
    "dev:cognito": "node scripts/dev-local.mjs --cognito",
    "identity:synth": "cdk synth --app \"npx tsx infra/identity.ts\" --output cdk.out/identity",
    "aws:preflight": "node scripts/aws-preflight.mjs",
    "setup:local": "node scripts/local-setup.mjs",
    "format": "prettier --write \"{apps,packages,infra,scripts,tests}/**/*.{ts,tsx,css}\"",
    "infra:check": "npm run infra:synth -- --quiet && tsx scripts/verify-infra.ts",
    "smoke:local": "tsx scripts/smoke-local.ts",
    "setup:cognito": "node scripts/setup-cognito.mjs",
    "cloud:plan": "node scripts/academic-cloud.mjs plan",
    "cloud:deploy": "node scripts/academic-cloud.mjs deploy",
    "cloud:inventory": "node scripts/academic-cloud.mjs inventory"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1155.0",
    "@aws-sdk/client-location": "^3.1155.0",
    "@aws-sdk/client-s3": "^3.1155.0",
    "@aws-sdk/client-secrets-manager": "^3.1155.0",
    "@aws-sdk/client-sns": "^3.1155.0",
    "@aws-sdk/client-sqs": "^3.1155.0",
    "@aws-sdk/s3-presigned-post": "^3.1155.0",
    "@aws-sdk/s3-request-presigner": "^3.1155.0",
    "aws-cdk-lib": "^2.274.0",
    "constructs": "^10.8.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.15.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "aws-cdk": "^2.1146.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
