# Real-account local development. Use configure-cognito.mjs with actual AWS outputs
# to create .env.cognito and generate SESSION_KEY without printing it.
NODE_ENV=development
AUTH_MODE=cognito
EVENT_TRANSPORT=database
DATABASE_URL=postgresql://response:local-development-only@127.0.0.1:5432/response_cognito
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:4000
AWS_REGION=ap-south-1
PORT=4000
SMS_ENABLED=false
LOCATION_RETENTION_HOURS=24
# Required real values are populated by the configuration helper:
# COGNITO_POOL_ID, COGNITO_CLIENT_ID, COGNITO_DOMAIN, SESSION_KEY
# AWS deployment injects its settings from CloudFormation and Secrets Manager.
# Never put AWS credentials or session keys in this example file.
